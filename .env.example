# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=research

# ---- Embeddings ----
# hash  : zero-setup, offline, deterministic (dev/tests; weaker semantics)
# local : sentence-transformers (pip install sentence-transformers), e.g. BAAI/bge-small-en-v1.5 (dim 384)
# openai: OpenAI-compatible API (set OPENAI_API_KEY)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Chunking ----
CHUNK_TARGET_WORDS=180
CHUNK_OVERLAP_WORDS=40

CORS_ORIGINS=http://localhost:3000
